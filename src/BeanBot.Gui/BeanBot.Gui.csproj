<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>BeanBot.Gui</RootNamespace>
    <AssemblyName>beanbot-gui</AssemblyName>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\BeanBot.Protocol\BeanBot.Protocol.csproj" />
    <ProjectReference Include="..\BeanBot.Transport\BeanBot.Transport.csproj" />
    <ProjectReference Include="..\BeanBot.Observability\BeanBot.Observability.csproj" />
    <ProjectReference Include="..\BeanBot.Accounts\BeanBot.Accounts.csproj" />
    <ProjectReference Include="..\BeanBot.Matchmaker\BeanBot.Matchmaker.csproj" />
    <ProjectReference Include="..\BeanBot.World\BeanBot.World.csproj" />
    <ProjectReference Include="..\BeanBot.Nav\BeanBot.Nav.csproj" />
    <ProjectReference Include="..\BeanBot.Behaviors\BeanBot.Behaviors.csproj" />
    <ProjectReference Include="..\BeanBot.Host\BeanBot.Host.csproj" />
    <ProjectReference Include="..\BeanBot.Commands\BeanBot.Commands.csproj" />
    <ProjectReference Include="..\BeanBot.Orchestrator\BeanBot.Orchestrator.csproj" />
  </ItemGroup>
</Project>
